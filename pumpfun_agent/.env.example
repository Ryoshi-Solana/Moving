# ===== Mode =====
# paper = simulasi dengan uang virtual (DEFAULT, mulai dari sini)
# live  = uang sungguhan. Lihat README bagian "Pindah ke live" sebelum mengubah ini.
AGENT_MODE=paper
PAPER_START_BALANCE_SOL=1.0

# ===== PumpPortal (WAJIB) =====
# Data trade realtime hanya untuk API key yang wallet PumpPortal-nya berisi ≥0.02 SOL.
# Buat di https://pumpportal.fun → "Generate API key", lalu kirim ≥0.02 SOL ke wallet itu.
PUMPPORTAL_API_KEY=

# ===== Telegram =====
# Token dari @BotFather, chat id dari @userinfobot (chat pribadi kamu)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Umum =====
AGENT_DB_PATH=data/agent.db
TZ_OFFSET_HOURS=7          # WIB
DAILY_REPORT_HOUR=21       # jam laporan harian (waktu lokal)
FETCH_METADATA=true        # cek twitter/telegram/website token kandidat
# Rekam semua event market untuk replay/backtest nanti (file bisa besar, ±1 GB/hari)
# AGENT_RECORD_PATH=data/feed.jsonl
LOG_LEVEL=INFO

# ===== Khusus LIVE (biarkan kosong selama paper trading) =====
# Pakai wallet BARU khusus agent, isi hanya dengan modal yang siap hilang.
# WALLET_PRIVATE_KEY=
# RPC privat wajib untuk live (Helius / Triton / QuickNode)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# Batas keras ukuran posisi live; /set tidak bisa melewatinya
# LIVE_MAX_POSITION_SOL=0.05
# Wajib persis seperti ini supaya mode live mau jalan:
# LIVE_TRADING_CONFIRM=SAYA_PAHAM_RISIKONYA
