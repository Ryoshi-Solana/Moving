# CoinMarketCap API key (https://pro.coinmarketcap.com/account)
# Server-side only. Never prefix with NEXT_PUBLIC_.
CMC_API_KEY=your_coinmarketcap_api_key_here

# Optional overrides
# CMC_BASE_URL=https://sandbox-api.coinmarketcap.com
# CMC_CACHE_TTL_SECONDS=60
# RATE_LIMIT_PER_MINUTE=20
# Fetch /v2/cryptocurrency/info (website link) on the first analysis of each asset.
# Off by default to stay inside the Basic plan's 50 requests/minute.
# CMC_INFO_LOOKUPS=true

# Exact public destinations. Set these in Vercel before public launch.
# Generic homepages are ignored; provide a profile path and the exact token page.
# NEXT_PUBLIC_X_URL=https://x.com/your-handle
# NEXT_PUBLIC_PUMPFUN_URL=https://pump.fun/coin/your-token-mint
