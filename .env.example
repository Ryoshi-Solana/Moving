# CoinMarketCap API key (https://pro.coinmarketcap.com/account)
# Server-side only. Never prefix with NEXT_PUBLIC_.
CMC_API_KEY=your_coinmarketcap_api_key_here

# Optional: point at the sandbox while developing without burning credits.
# Sandbox key is the public one from CMC docs.
# CMC_BASE_URL=https://sandbox-api.coinmarketcap.com

# Optional overrides
# CMC_CACHE_TTL_SECONDS=60
# RATE_LIMIT_PER_MINUTE=20
